#!/bin/sh
# The race unit suite, which is what the CI lint job runs. The AC suite,
# kind smoke and campaign e2e stay in CI; `make test` runs the full gate
# locally when you want it.
# Bypass once with `git push --no-verify`.
set -u

# The pinned linter is built with go1.21.6 and cannot read export data from
# a newer toolchain. Set GOTOOLCHAIN to another value to override.
GOTOOLCHAIN=${GOTOOLCHAIN:-go1.21.6}
export GOTOOLCHAIN

printf 'pre-push: go test -race -short ./...\n'
go test -race -short ./... -count=1 || {
	printf '\npre-push: unit tests failed, push aborted\n\n' >&2
	exit 1
}
