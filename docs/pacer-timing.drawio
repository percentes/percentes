<mxfile host="app.diagrams.net" type="device">
  <diagram name="Pacer timing model" id="pacer-timing">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="480" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="The two-stage precise wait — one request's dispatch" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend1" value="CPU idle — timer sleep" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="55" y="52" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legsw1" value="" style="rounded=0;fillColor=#85B7EB;strokeColor=#185FA5;" vertex="1" parent="1">
          <mxGeometry x="30" y="55" width="16" height="14" as="geometry" />
        </mxCell>
        <mxCell id="legend2" value="CPU hot — busy-spin" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="255" y="52" width="150" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legsw2" value="" style="rounded=0;fillColor=#F09595;strokeColor=#A32D2D;" vertex="1" parent="1">
          <mxGeometry x="230" y="55" width="16" height="14" as="geometry" />
        </mxCell>
        <mxCell id="scalenote" value="(horizontal scale not exact)" style="text;html=1;fontSize=11;fontColor=#888780;align=left;" vertex="1" parent="1">
          <mxGeometry x="440" y="52" width="200" height="20" as="geometry" />
        </mxCell>

        <mxCell id="pacerlbl" value="PACER · 1 thread" style="text;html=1;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="95" width="150" height="20" as="geometry" />
        </mxCell>
        <mxCell id="pacersleep" value="sleeping" style="rounded=1;fillColor=#B5D4F4;strokeColor=#378ADD;fontSize=11;fontColor=#042C53;" vertex="1" parent="1">
          <mxGeometry x="30" y="118" width="130" height="32" as="geometry" />
        </mxCell>
        <mxCell id="pacernext" value="sleeps until next request's (T − 10 ms) — moves on immediately" style="rounded=1;fillColor=#E6F1FB;strokeColor=#85B7EB;fontSize=11;fontColor=#0C447C;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="160" y="118" width="640" height="32" as="geometry" />
        </mxCell>

        <mxCell id="spawnedge" value="spawn worker i" style="endArrow=classic;html=1;strokeColor=#0F6E56;fontColor=#0F6E56;fontSize=11;" edge="1" parent="1" source="pacersleep" target="wtimer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="150" as="sourcePoint" />
            <mxPoint x="160" y="190" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="workerlbl" value="WORKER i · goroutine" style="text;html=1;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="175" width="180" height="20" as="geometry" />
        </mxCell>
        <mxCell id="wtimer" value="timer sleep ≈ 8.5 ms  (&lt;-waitTimer.C)" style="rounded=1;fillColor=#85B7EB;strokeColor=#185FA5;fontSize=11;fontColor=#042C53;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="160" y="198" width="420" height="34" as="geometry" />
        </mxCell>
        <mxCell id="wspin" value="spin 1.5 ms" style="rounded=1;fillColor=#F09595;strokeColor=#A32D2D;fontSize=11;fontColor=#501313;" vertex="1" parent="1">
          <mxGeometry x="580" y="198" width="110" height="34" as="geometry" />
        </mxCell>
        <mxCell id="wpost" value="POST (SSE)" style="rounded=1;fillColor=#D3D1C7;strokeColor=#888780;fontSize=11;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="690" y="198" width="110" height="34" as="geometry" />
        </mxCell>

        <mxCell id="m1" value="T − 10 ms&#10;spawnLeadNs" style="text;html=1;fontSize=11;align=center;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="110" y="245" width="100" height="34" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="T − 1.5 ms&#10;spinNs" style="text;html=1;fontSize=11;align=center;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="530" y="245" width="100" height="34" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="T = IntendedNs&#10;exact send" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#A32D2D;align=center;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="640" y="245" width="110" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ml1" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#B4B2A9;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="160" y="110" as="sourcePoint" /><mxPoint x="160" y="245" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="ml2" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#B4B2A9;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="580" y="110" as="sourcePoint" /><mxPoint x="580" y="245" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="ml3" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#A32D2D;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="690" y="110" as="sourcePoint" /><mxPoint x="690" y="245" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="caption" value="Late spawn ⇒ the worker's runway shrinks, but it still aims at the ABSOLUTE T. Jitter never cascades to the next request (coordinated-omission defence)." style="text;html=1;fontSize=11;fontStyle=2;fontColor=#5F5E5A;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="290" width="770" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
